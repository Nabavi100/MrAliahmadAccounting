# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: The secret token for the official Telegram Bot integration.
# Can also be configured directly via the protected Telegram settings in the app.
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# ---------------------------------------------------------------------------
# APP_DATA_KEY: Protective access key for the server-side accounting data API.
#
# Highly recommended on any server reachable from the internet. When set:
#   • /api/app/data, /api/app/backups and the Telegram endpoints of the data API
#     only answer requests that carry the matching `x-app-key` header,
#   • the key is injected into the served HTML (meta[name="app-data-key"]) so the
#     official application connects automatically — no client configuration,
#   • every user/device of the company needs the same server (nothing to install).
#
# Change it to a long random value and keep it private, for example:
#   APP_DATA_KEY="$(openssl rand -hex 32)"
# ---------------------------------------------------------------------------
APP_DATA_KEY=""
